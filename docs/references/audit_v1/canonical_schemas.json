{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed student support simulation contracts",
  "description": "Audit design proposal, 6 October 2026. Adopt through explicit adapters and tests. Source field mapping uses logical paths; observation.<field> is represented as a fact with that field name. Higher education remains a separate adapter and is not a valid school Student. No raw file was migrated.",
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "type": "string"
        },
        "source_anchor_student_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_dataset": {
          "type": "string"
        },
        "source_row": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "linkage_group_id": {
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "anchor_subject": {
          "enum": [
            "portuguese",
            "math"
          ]
        },
        "record_provenance": {
          "enum": [
            "OBSERVED FROM DATA",
            "ESTIMATED FROM DATA",
            "DERIVED",
            "EXTERNALLY INFORMED",
            "ASSUMED FOR SIMULATION",
            "GENERATED"
          ]
        }
      },
      "required": [
        "student_id",
        "source_anchor_student_id",
        "source_dataset",
        "source_row",
        "linkage_group_id",
        "split",
        "anchor_subject",
        "record_provenance"
      ],
      "description": "Local identities and split metadata. Source anchors are not verified person identities. Exclude linkage keys, source rows and split labels from prediction features."
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "population": {
          "enum": [
            "portugal_secondary_school"
          ]
        },
        "static": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "school_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "age_years": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 120
            },
            "rural_residence": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "family_size_gt3": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "parents_apart": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "mother_education_code": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4
            },
            "father_education_code": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4
            },
            "mother_job": {
              "type": [
                "string",
                "null"
              ]
            },
            "father_job": {
              "type": [
                "string",
                "null"
              ]
            },
            "guardian": {
              "type": [
                "string",
                "null"
              ]
            },
            "past_failures_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "nursery_attended": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "household_id": {
              "type": "null"
            },
            "income_amount": {
              "type": "null"
            },
            "income_currency": {
              "type": "null"
            },
            "verified_economic_disadvantage": {
              "type": "null"
            }
          },
          "required": [
            "school_id",
            "age_years",
            "rural_residence",
            "family_size_gt3",
            "parents_apart",
            "mother_education_code",
            "father_education_code",
            "mother_job",
            "father_job",
            "guardian",
            "past_failures_count",
            "nursery_attended",
            "household_id",
            "income_amount",
            "income_currency",
            "verified_economic_disadvantage"
          ]
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sex_source": {
              "enum": [
                "F",
                "M",
                null
              ]
            },
            "both_parents_education_at_most_2": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "no_home_internet": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "travel_over_30min": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "disadvantage_proxy_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "disadvantage_proxy_group": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "sex_source",
            "both_parents_education_at_most_2",
            "no_home_internet",
            "travel_over_30min",
            "disadvantage_proxy_count",
            "disadvantage_proxy_group"
          ]
        }
      },
      "required": [
        "lineage",
        "population",
        "static",
        "audit"
      ],
      "description": "Proposed adapter output for the supplied school population. Keep source sex for audits; sensitive fields are not inferred from text. Static means baseline context frozen in the initial experiment, not immutable throughout life. Proxy flags are derived baseline audit strata, never verified poverty."
    },
    "observation_fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "travel_time_category",
            "study_time_category",
            "school_support_existing",
            "family_support_existing",
            "paid_classes_existing",
            "extracurricular",
            "higher_education_aspiration",
            "internet_at_home",
            "family_relationship_rating",
            "health_self_rating",
            "anchor_grade1_0_20",
            "math_grade1_0_20",
            "attendance_fraction",
            "engagement",
            "learning_gap",
            "enrolled",
            "financial_need_verified",
            "eligible_for_tutoring"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "reported",
            "negated",
            "uncertain",
            "unknown",
            "conflicting"
          ]
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "available_at_step": {
          "type": "integer",
          "minimum": 0
        },
        "source_type": {
          "enum": [
            "source_record",
            "structured_observation",
            "mentor_note",
            "simulation_observation",
            "assessment"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "evidence_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "enum": [
            "OBSERVED FROM DATA",
            "ESTIMATED FROM DATA",
            "DERIVED",
            "EXTERNALLY INFORMED",
            "ASSUMED FOR SIMULATION",
            "GENERATED"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "field",
        "value",
        "status",
        "source_date",
        "source_step",
        "available_at_step",
        "source_type",
        "source_id",
        "evidence_span",
        "provenance",
        "confidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "travel_time_category"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "study_time_category"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "school_support_existing"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "family_support_existing"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "paid_classes_existing"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "extracurricular"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "higher_education_aspiration"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "internet_at_home"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "family_relationship_rating"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "health_self_rating"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "anchor_grade1_0_20"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "math_grade1_0_20"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "attendance_fraction"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "engagement"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "learning_gap"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "enrolled"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "financial_need_verified"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "eligible_for_tutoring"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "conflicting"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "One timestamped fact. Date and step can remain unknown in original snapshots; available_at_step is an explicit experimental availability assumption. Unknown/conflict uses null, with alternative assertions represented as separate evidence records. Confidence is null unless calibrated. No latent response, future label or reward field is allowed."
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "type": "string"
        },
        "as_of_step": {
          "type": "integer",
          "minimum": 0
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation_fact"
          }
        }
      },
      "required": [
        "student_id",
        "as_of_step",
        "facts"
      ],
      "description": "Policy observation envelope. Application validation additionally requires available_at_step <= as_of_step and consistent field units. Generated simulator observations are labelled as such, never observed-source evidence."
    },
    "hidden_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "learning_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attendance_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "engagement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "response_tendency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "financial_barrier": {
          "type": "boolean"
        },
        "enrollment_state": {
          "enum": [
            "enrolled",
            "withdrawn"
          ]
        },
        "weekly_withdrawal_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "enum": [
            "ASSUMED FOR SIMULATION",
            "GENERATED"
          ]
        }
      },
      "required": [
        "student_id",
        "step",
        "learning_gap",
        "attendance_fraction",
        "engagement",
        "response_tendency",
        "financial_barrier",
        "enrollment_state",
        "weekly_withdrawal_probability",
        "provenance"
      ],
      "description": "Environment-only evolving state. Hidden truth is never an argument to ordinary policy or note-rendering interfaces. Realizations of future outcomes are deliberately absent."
    },
    "reference_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "type": "string"
        },
        "subject": {
          "enum": [
            "portuguese",
            "math"
          ]
        },
        "grade2_0_20": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 20
        },
        "final_grade_0_20": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 20
        },
        "total_absences": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "course_failure_proxy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_school_dropout": {
          "type": "null"
        }
      },
      "required": [
        "student_id",
        "subject",
        "grade2_0_20",
        "final_grade_0_20",
        "total_absences",
        "course_failure_proxy",
        "observed_school_dropout"
      ],
      "description": "Offline school reference only. Course failure is G3 < 10; total absences has no dated denominator."
    },
    "mentor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mentor_id": {
          "type": "string"
        },
        "support_types": {
          "type": "array",
          "items": {
            "enum": [
              "tutoring",
              "family_liaison",
              "transport_assessment"
            ]
          }
        },
        "max_active_students": {
          "type": "integer",
          "minimum": 0
        },
        "current_student_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availability_by_step": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0
              },
              "available_hours": {
                "type": "number",
                "minimum": 0
              },
              "max_sessions": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "step",
              "available_hours",
              "max_sessions"
            ]
          }
        },
        "eligible_program_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost_units_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "enum": [
            "ASSUMED FOR SIMULATION",
            "GENERATED"
          ]
        }
      },
      "required": [
        "mentor_id",
        "support_types",
        "max_active_students",
        "current_student_ids",
        "availability_by_step",
        "eligible_program_ids",
        "cost_units_per_hour",
        "provenance"
      ],
      "description": "No mentor observations exist in source data. Availability and caseload are separate constraints. Zero assignments are valid; application checks must reconcile current commitments."
    },
    "intervention_program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "type": "string"
        },
        "support_type": {
          "enum": [
            "tutoring",
            "family_liaison",
            "transport_assessment"
          ]
        },
        "n_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "session_duration_hours": {
          "type": "number",
          "minimum": 0
        },
        "session_offsets_steps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "acceptance_delay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "effect_delay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "offer_admin_hours": {
          "type": "number",
          "minimum": 0
        },
        "cost_units_per_delivered_session": {
          "type": "number",
          "minimum": 0
        },
        "eligibility_rule_id": {
          "type": "string"
        },
        "missed_session_rule_id": {
          "type": "string"
        },
        "effect_scenario_id": {
          "type": "string"
        },
        "provenance": {
          "enum": [
            "ASSUMED FOR SIMULATION",
            "EXTERNALLY INFORMED"
          ]
        }
      },
      "required": [
        "program_id",
        "support_type",
        "n_sessions",
        "session_duration_hours",
        "session_offsets_steps",
        "acceptance_delay_steps",
        "effect_delay_steps",
        "offer_admin_hours",
        "cost_units_per_delivered_session",
        "eligibility_rule_id",
        "missed_session_rule_id",
        "effect_scenario_id",
        "provenance"
      ],
      "description": "Initial proposed tutoring programme has configurable five sessions. Session count must equal schedule length; enforce in code. Duration is derived from the schedule, not synonymous with session count. Every numerical choice needs a scenario register entry."
    },
    "intervention_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "student_id": {
          "type": "string"
        },
        "mentor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "program_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "enum": [
            "offered",
            "accepted",
            "refused",
            "scheduled",
            "delivered",
            "missed",
            "cancelled",
            "completed"
          ]
        },
        "session_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "delivered_hours": {
          "type": "number",
          "minimum": 0
        },
        "charged_cost_units": {
          "type": "number",
          "minimum": 0
        },
        "reserved_future_hours": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "enum": [
            "simulated_event"
          ]
        }
      },
      "required": [
        "event_id",
        "student_id",
        "mentor_id",
        "program_id",
        "episode_id",
        "step",
        "event_type",
        "session_number",
        "delivered_hours",
        "charged_cost_units",
        "reserved_future_hours",
        "source"
      ],
      "description": "Offer, delivery and completion are distinct. Do not include latent response effects or future withdrawal outcomes in events provided to the note generator."
    },
    "simulation_outcome": {
      "type": "object",
